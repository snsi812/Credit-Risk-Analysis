<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="creditrisk.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3309"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="scored_applicants" custom_title="0" dock_id="1" table="4,17:mainscored_applicants"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">

-- ============================================================================
-- QUERY 1 — Automated Approval Decision Logic
-- ============================================================================
-- WHY? This is the core decision engine of the entire project. Instead of a
-- human manually reviewing each applicant's credit score, this query applies
-- a consistent, auditable rule to every single row: score above 750 is
-- auto-approved, 600-750 goes to manual review, below 600 is auto-rejected.
-- This removes human bias and makes every decision explainable and repeatable.
-- ============================================================================

SELECT
    rowid AS applicant_id,
    credit_score,
    CASE
        WHEN credit_score &gt; 750 THEN 'Approved'
        WHEN credit_score BETWEEN 600 AND 750 THEN 'Review'
        ELSE 'Rejected'
    END AS decision,
    CASE
        WHEN credit_score &gt;= 800 THEN 'Very Safe'
        WHEN credit_score &gt;= 700 THEN 'Safe'
        WHEN credit_score &gt;= 600 THEN 'Moderate Risk'
        ELSE 'High Risk'
    END AS risk_category
FROM scored_applicants;


-- ============================================================================
-- QUERY 2 — Overall Approval Rate Summary
-- ============================================================================

SELECT
    COUNT(*) AS total_applicants,
    SUM(CASE WHEN decision = 'Approved' THEN 1 ELSE 0 END) AS approved,
    SUM(CASE WHEN decision = 'Review'   THEN 1 ELSE 0 END) AS under_review,
    SUM(CASE WHEN decision = 'Rejected' THEN 1 ELSE 0 END) AS rejected,
    ROUND(SUM(CASE WHEN decision = 'Approved' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS approval_rate_pct,
    ROUND(SUM(CASE WHEN decision = 'Rejected' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS rejection_rate_pct
FROM scored_applicants;


-- ============================================================================
-- QUERY 3 — Risk Category Distribution with Average Score
-- ============================================================================

SELECT
    risk_category,
    COUNT(*) AS total_applicants,
    ROUND(AVG(credit_score), 0) AS avg_credit_score,
    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM scored_applicants), 2) AS pct_of_total
FROM scored_applicants
GROUP BY risk_category
ORDER BY avg_credit_score DESC;


-- ============================================================================
-- QUERY 4 — Average Credit Score by Actual Default Outcome
========================================================

SELECT
    loan_status,
    COUNT(*) AS total_applicants,
    ROUND(AVG(credit_score), 0) AS avg_credit_score,
    MIN(credit_score) AS min_score,
    MAX(credit_score) AS max_score
FROM scored_applicants
GROUP BY loan_status;


-- ============================================================================
-- QUERY 5 — High-Risk Applicant Watchlist
-- ============================================================================

SELECT
    rowid AS applicant_id,
    credit_score,
    risk_category,
    decision,
    loan_status
FROM scored_applicants
WHERE risk_category = 'High Risk'
ORDER BY credit_score ASC
LIMIT 20;


-- ============================================================================
-- QUERY 6 — Score Band Distribution (Portfolio Health Check)
-- ============================================================================

SELECT
    CASE
        WHEN credit_score &gt;= 800 THEN '800-900 (Very Safe)'
        WHEN credit_score &gt;= 700 THEN '700-799 (Safe)'
        WHEN credit_score &gt;= 600 THEN '600-699 (Moderate Risk)'
        WHEN credit_score &gt;= 500 THEN '500-599 (High Risk)'
        ELSE 'Below 500 (Very High Risk)'
    END AS score_band,
    COUNT(*) AS total_applicants,
    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM scored_applicants), 2) AS pct_of_total
FROM scored_applicants
GROUP BY score_band
ORDER BY MIN(credit_score) DESC;


-- ============================================================================
-- QUERY 7 — Approved Applicants Ranked by Income
-- ============================================================================

SELECT
    rowid AS applicant_id,
    person_income,
    credit_score,
    decision,
    risk_category
FROM scored_applicants
WHERE decision = 'Approved'
ORDER BY person_income DESC
LIMIT 20;


-- ============================================================================
-- QUERY 8 — Final KPI Summary (Dashboard Feed Query)
-- ============================================================================

SELECT 'Total Applicants'  AS metric, COUNT(*)                                                AS value FROM scored_applicants
UNION ALL
SELECT 'Approved',          SUM(CASE WHEN decision = 'Approved' THEN 1 ELSE 0 END)            FROM scored_applicants
UNION ALL
SELECT 'Under Review',      SUM(CASE WHEN decision = 'Review'   THEN 1 ELSE 0 END)            FROM scored_applicants
UNION ALL
SELECT 'Rejected',          SUM(CASE WHEN decision = 'Rejected' THEN 1 ELSE 0 END)            FROM scored_applicants
UNION ALL
SELECT 'High Risk Count',   SUM(CASE WHEN risk_category = 'High Risk' THEN 1 ELSE 0 END)      FROM scored_applicants
UNION ALL
SELECT 'Avg Credit Score',  ROUND(AVG(credit_score), 0)                                       FROM scored_applicants;</sql><current_tab id="0"/></tab_sql></sqlb_project>
